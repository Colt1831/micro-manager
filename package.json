{
  "name": "workmanagement",
  "private": true,
  "version": "0.1.0",
  "description": "Enterprise work & task management platform",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "clean": "turbo clean",
    "test:smoke": "vitest run",
    "db:generate": "pnpm --filter @workmanagement/database db:generate",
    "db:migrate": "pnpm --filter @workmanagement/database db:migrate",
    "db:push": "pnpm --filter @workmanagement/database db:push",
    "db:seed": "pnpm --filter @workmanagement/database db:seed",
    "db:studio": "pnpm --filter @workmanagement/database db:studio"
  },
  "dependencies": {
    "@workmanagement/database": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "turbo": "^2.10.10",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "postcss": ">=8.5.18",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "undici": ">=7.29.0 <8",
      "fast-uri": ">=3.1.6 <4",
      "sharp": ">=0.35.4",
      "browserslist": ">=4.28.7",
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "js-yaml@4": ">=4.3.2 <5",
      "nanoid@<3.3.17": ">=3.3.17 <4"
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
